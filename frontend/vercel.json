{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "installCommand": "npx -y npm@11.6.1 ci",
  "buildCommand": "npm run build",
  "git": { "deploymentEnabled": false },
  "redirects": [
    { "source": "/dao", "destination": "/governance", "permanent": true },
    { "source": "/carbon", "destination": "/carbon-tracker", "permanent": true },
    { "source": "/market", "destination": "/marketplace", "permanent": true },
    { "source": "/quest", "destination": "/quests", "permanent": true }
  ],
  "headers": [
    {
      "source": "/360/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
