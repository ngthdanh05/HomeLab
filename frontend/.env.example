# WalletConnect Project ID (lấy từ https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Chain ID (11155111 = Sepolia Testnet, 31337 = Anvil Localnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# Google Gemini API Key (lấy từ https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# (Tuỳ chọn) Model Gemini, mặc định gemini-3.8-flash
GEMINI_MODEL=

# (Tuỳ chọn) RPC Sepolia riêng cho frontend; để trống sẽ dùng RPC công khai mặc định
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# (Tuỳ chọn) Pinata JWT để tải ảnh/metadata sản phẩm lên IPFS (chỉ dùng phía server)
PINATA_JWT=

# (Tuỳ chọn) IPFS gateway để hiển thị ảnh/metadata
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
